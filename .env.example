APP_NAME=SpendTrace
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
BOOST_ENABLED=false

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=spendtrace
DB_USERNAME=spendtrace
DB_PASSWORD=spendtrace-local-only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
CACHE_STORE=database
BROADCAST_CONNECTION=log
MAIL_MAILER=log

RECEIPT_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
INERTIA_SSR_ENABLED=false
VITE_APP_NAME=SpendTrace

# Reachable HTTPS origin for iPhone Shortcuts (no path or credentials).
# Uses APP_URL when blank. No integration secret belongs in this file.
WALLET_PUBLIC_URL=

# Set only after publishing and physically validating the shared, credential-free shortcut.
WALLET_SHORTCUT_URL=
WALLET_SHORTCUT_VERSION=0.1.0-unreleased
WALLET_SHORTCUT_VERIFIED=false

# Comma-separated reverse-proxy IPs; leave empty without a trusted proxy.
TRUSTED_PROXIES=
